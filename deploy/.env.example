# ============================================================
# 部署环境变量模板
#   使用方法：  cp .env.example .env   然后填写下面的值
#   说明：本文件(.env.example)可提交 git；.env(真实密钥) 已被 .gitignore 忽略
# ============================================================

# ---------- MySQL 数据库 ----------
# root 管理员密码（建议 16 位以上强密码）
MYSQL_ROOT_PASSWORD=change_me_root_password
# 应用数据库名 / 账号 / 密码（后端会自动复用这套 MYSQL_USER 连接，无需另填 DB_*）
MYSQL_DATABASE=code_review
MYSQL_USER=code_review
MYSQL_PASSWORD=change_me_app_password
# 仅首次建库时使用；12-32 个字符且不超过 72 字节，不得使用默认值或模板值。
INITIAL_ADMIN_PASSWORD=change_me_to_a_strong_initial_admin_password

# ---------- 安全：JWT 密钥 ----------
# 必改！生成随机串： openssl rand -hex 32
JWT_SECRET=change_me_to_a_32+_char_random_string
# 独立 API Key 加密密钥环(JSON 数组)：第一项用于新写入，轮换时把旧值暂留在后面。
# 必须与 JWT_SECRET 不同；生成方式同上。完成机会式迁移后再移除旧项。
API_KEY_ENCRYPTION_KEYS=["change_me_api_key_encryption_secret_1"]

# ---------- 内测注册 ----------
# 管理员生成首批内测码并确认管理页可用后再改为 true。
BETA_REGISTRATION_ENABLED=false
# 必须使用独立随机值，不能与 JWT_SECRET 相同；明文邀请码以此计算 HMAC 摘要。
BETA_CODE_PEPPER=change_me_beta_code_pepper_at_least_32_chars

# ---------- DeepSeek 大模型 ----------
# 必填，从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CONTEXT_WINDOW_TOKENS=1000000
DEEPSEEK_MAX_OUTPUT_TOKENS=32768
SECURITY_SEMANTIC_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_COMPACTION_THRESHOLD_TOKENS=850000
DEEPSEEK_COMPACTION_KEEP_RECENT_TOKENS=200000
SECURITY_SEMANTIC_BATCH_CHARS=60000
SECURITY_SEMANTIC_MIN_SPLIT_CHARS=2000
SECURITY_SEMANTIC_MAX_SPLIT_DEPTH=8
SECURITY_SEMANTIC_MAX_REQUESTS=128
SECURITY_SEMANTIC_TIMEOUT_SECONDS=1800
SECURITY_SEMANTIC_MAX_FINDINGS_PER_BATCH=12
SECURITY_SEMANTIC_MAX_GRAPH_ITEMS_PER_BATCH=20
SECURITY_SEMANTIC_BOUNDED_TOTAL_CHARS=16000
SECURITY_SEMANTIC_BOUNDED_PER_FILE_CHARS=4000
SECURITY_SEMANTIC_BOUNDED_MAX_FILES=4
# 默认阻止用户自定义 API 指向 localhost/内网/链路本地地址，防止 SSRF。
# 仅在明确部署内网模型服务且已做好网络隔离时改为 true。
ALLOW_PRIVATE_AI_BASE_URL=false
# 若运行环境没有 fake-IP/代理 DNS，可改为 true，对域名解析结果也做公网校验。
ENFORCE_AI_BASE_URL_DNS_CHECK=false

# ---------- Agent 治理与知识抓取 ----------
# 后端启动时是否注册每日知识抓取、反思、自进化任务。
AGENT_GOVERNANCE_SCHEDULER_ENABLED=true
# Agent 外部知识源抓取超时和单次最大响应体，避免慢源/大响应拖垮调度。
AGENT_KNOWLEDGE_FETCH_TIMEOUT=15
AGENT_KNOWLEDGE_FETCH_MAX_BYTES=1048576
# 默认阻止 Agent 知识抓取指向 localhost/内网/保留地址，防止 SSRF。
AGENT_KNOWLEDGE_ALLOW_PRIVATE_URLS=false
# 若运行环境没有 fake-IP/代理 DNS，可改为 true，对知识源域名解析结果做公网校验。
AGENT_KNOWLEDGE_ENFORCE_DNS_CHECK=false
# 可选：抓 GitHub issue/PR 时使用，避免匿名限流；真实 token 只写入 .env，不提交仓库。
AGENT_KNOWLEDGE_GITHUB_TOKEN=

# ---------- AI 自动运维 ----------
# 仅供 Backend 通过 Unix Socket 调用宿主机白名单执行器；不得复用 JWT_SECRET。
OPS_AUTOMATION_ENABLED=true
OPS_EXECUTOR_SOCKET=/run/prism-ops/agent.sock
OPS_EXECUTOR_TOKEN=change_me_to_an_independent_64_character_random_token

# ---------- 安全监控（security_monitor_service，均为只读规则阈值） ----------
# 安全巡检总开关；关闭后定时任务返回 disabled，不拉取任何只读安全事件。
SECURITY_MONITOR_ENABLED=true
# 安全巡检间隔（分钟），与调度器 interval@Nm 保持一致（默认 5 分钟）。
SECURITY_MONITOR_INTERVAL_MINUTES=5
# SSH 来源白名单 CIDR（JSON 数组）；命中白名单的成功登录只入库不弹窗。
SECURITY_SSH_ALLOWLIST_CIDRS=[]
# SSH 失败登录爆破阈值：同 IP 在窗口内失败次数达到该值触发 warning 告警。
SECURITY_FAILED_LOGIN_THRESHOLD=20
# SSH 失败登录统计窗口（小时）。
SECURITY_FAILED_LOGIN_WINDOW_HOURS=1
# 蜜罐触碰阈值：同 IP 在窗口内触碰次数达到该值触发 warning 告警。
SECURITY_FLYTRAP_THRESHOLD=10
# 蜜罐触碰统计窗口（小时）。
SECURITY_FLYTRAP_WINDOW_HOURS=1
# 备份超龄阈值（小时）：最新备份 age 超过该值触发 high 告警。
SECURITY_BACKUP_MAX_AGE_HOURS=30
# 备份目录体积上限（GB）：sql_gz + 其他产物超过该值触发 warning 告警。
SECURITY_BACKUP_DIR_MAX_GB=10
# 弹窗最低严重度：info<warning<high<critical；低于该等级的告警只入库不弹窗。
SECURITY_POPUP_MIN_SEVERITY=warning
# 被动溯源情报服务固定前缀（执行器侧再校验 URL 白名单；无真实密钥）。
THREAT_INTEL_BASE_URL=http://ip-api.com/json

# ---------- 生产数据库内部威胁监控（只读 mysql.general_log 采样） ----------
# 须先在数据库开启 general_log 且 log_output 含 TABLE：
#   SET GLOBAL general_log=ON; SET GLOBAL log_output='TABLE';
# 未开启时该动作返回 ok=False，不产生告警、不影响整体巡检。
SECURITY_DB_MONITOR_ENABLED=true
SECURITY_DB_WINDOW_HOURS=1
SECURITY_DB_SAMPLE_LIMIT=4000
# 破坏性写（DROP/TRUNCATE/DELETE/权限变更）达到该条数即 critical 告警。
SECURITY_DB_DESTRUCTIVE_THRESHOLD=1
# 批量导出/外泄（SELECT INTO OUTFILE/LOAD_FILE）达到该条数即 critical 告警。
SECURITY_DB_DUMP_THRESHOLD=1
# 访问异常/拒绝达到该条数即 warning 告警。
SECURITY_DB_ERROR_THRESHOLD=3

# ---------- 生产数据库自动备份 ----------
# 默认关闭；置 true 后调度器每日 02:30 自动执行一次一致性压缩备份。
# 过期轮换清理由 backup.sh 按 BACKUP_RETENTION_DAYS 完成；失败推送 critical 弹窗。
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=14

# ---------- 代码测试与部署沙箱 ----------
# 执行器与生产运维执行器完全分离；隔离运行时未就绪时失败关闭。
SANDBOX_ENABLED=false
SANDBOX_EXECUTOR_SOCKET=/var/lib/prism-sandbox/agent.sock
SANDBOX_EXECUTOR_TOKEN=change_me_to_an_independent_64_character_random_token
SANDBOX_DEFAULT_TTL_HOURS=72
SANDBOX_MAX_TTL_HOURS=168
SANDBOX_MAX_CONCURRENCY=1
SANDBOX_REQUIRED_RUNTIME=runsc
SANDBOX_MODE=strict
SANDBOX_ALLOW_RUNC=false
SANDBOX_REMOTE_TARGETS_ENABLED=true

# ---------- 恶意文件扫描 ----------
# Backend 通过 Compose 私网访问 ClamAV；3310 不发布到宿主公网。
CLAMAV_TIMEOUT=5
CLAMAV_RECHECK_SECONDS=30
# 待审计源码包保留原压缩包；20MiB 上限保证单行低于 MySQL 64MiB packet。
SOURCE_ARCHIVE_MAX_BYTES=20971520
SOURCE_ARCHIVE_CLAMAV_TIMEOUT=120
# 生产必须保持 true：主扫描能力降级、错误或超时时拒绝上传。
MALWARE_SCAN_FAIL_CLOSED=true
YARA_MATCH_TIMEOUT=5
SOURCE_ARCHIVE_YARA_TOTAL_TIMEOUT=300

# ---------- 接口文档 / 审查并发 ----------
# 生产建议关闭公网 Swagger(/docs、/redoc)暴露;需临时演示 API 时改回 true 并重启后端。
OPENAPI_ENABLED=false
# 同时进行的后台审查任务数上限(防止小内存机器线程/内存放大、撞 LLM 限流)。
REVIEW_MAX_CONCURRENCY=2

# ---------- 跨域 CORS ----------
# JSON 数组格式。前端通过 nginx 同源访问时通常用不到；
# 生产环境统一使用 HTTPS 域名入口，不建议公网直连后端 8000 端口。
CORS_ORIGINS=["http://localhost:5173","https://your-domain.com"]

# ---------- 生产域名 ----------
# Nginx 模板、证书路径与发布冒烟统一使用以下值。
APP_DOMAIN=your-domain.com
APP_DOMAIN_ALIASES=www.your-domain.com
SERVER_IP=127.0.0.1

# ---------- 登录来源地理数据 ----------
# 宿主机上的真实 GeoLite2-City 数据库，以只读卷挂载到 Backend。
# 生产发布前必须确认文件存在且可被容器读取。
GEOLITE_DB_HOST_PATH=/opt/code-review/backend/GeoLite2-City.mmdb

# ---------- 发布与资源上限（可按服务器容量调整） ----------
BACKEND_RELEASE=local
FRONTEND_RELEASE=local
APP_RELEASE=local
MYSQL_MEM_LIMIT=640m
BACKEND_MEM_LIMIT=768m
FRONTEND_MEM_LIMIT=128m
CLAMAV_MEM_LIMIT=1400m
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
