# Production defaults are fail-closed. Use the exact same token, TTL and
# concurrency values in deploy/.env; install.sh rejects drift before mutation.
SANDBOX_EXECUTOR_TOKEN=change_me_to_an_independent_64_character_random_token
SANDBOX_EXECUTOR_MODE=strict
SANDBOX_RUNTIME=runsc
SANDBOX_ALLOW_RUNC_LOCAL_DEVELOPMENT=false
SANDBOX_EXECUTOR_SOCKET=/var/lib/prism-sandbox/agent.sock
SANDBOX_STATE_DIR=/var/lib/prism-sandbox/state
SANDBOX_JOB_DIR=/var/lib/prism-sandbox/jobs
SANDBOX_PROFILE_FILE=/opt/code-review/deploy/sandbox/profiles.json
SANDBOX_MAX_CONCURRENCY=1
SANDBOX_MAX_ARCHIVE_BYTES=33554432
SANDBOX_MAX_EXPANDED_BYTES=134217728
SANDBOX_MAX_OUTPUT_BYTES=2097152
SANDBOX_DEFAULT_TTL_SECONDS=259200
SANDBOX_MAX_TTL_SECONDS=604800

# 官方 Playwright MCP 镜像必须以仓库摘要固定；安装脚本同时校验本地
# RepoDigests，worker health 未达到 browser_blackbox.ready 时不会启用 MCP。
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright/mcp@sha256:ee3cf88586e9ab285cba00e06da77c9853c45e80ba25cf9af153aac71f19c45b
PLAYWRIGHT_IMAGE_DIGEST=sha256:ee3cf88586e9ab285cba00e06da77c9853c45e80ba25cf9af153aac71f19c45b
PLAYWRIGHT_TIMEOUT_SECONDS=90

# Local development is the only supported runc fallback. Both switches are
# required; never use these values on a shared or production host.
# SANDBOX_EXECUTOR_MODE=local_development
# SANDBOX_ALLOW_RUNC_LOCAL_DEVELOPMENT=true
