[Unit]
Description=Prism fail-closed code sandbox executor
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=prism-sandbox
Group=prism-sandbox
SupplementaryGroups=docker
WorkingDirectory=@DEPLOY_DIR@
EnvironmentFile=@DEPLOY_DIR@/sandbox/.env
# socket 直接落在持久 StateDirectory:执行器 unlink+重建同一路径,Backend
# 容器挂载该目录,挂载点始终跟随文件路径,执行器重启后容器内的 socket
# 引用依然有效。StateDirectoryMode=0770 让 Backend(group 992)可进入读取。
Environment=SANDBOX_EXECUTOR_SOCKET=/var/lib/prism-sandbox/agent.sock
StateDirectory=prism-sandbox
StateDirectoryMode=0770
LogsDirectory=prism-sandbox
LogsDirectoryMode=0700
UMask=0007
ExecStart=/usr/bin/python3 @DEPLOY_DIR@/prism_sandbox_executor.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
TasksMax=64
LimitNOFILE=1024
MemoryMax=256M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RemoveIPC=true

[Install]
WantedBy=multi-user.target
