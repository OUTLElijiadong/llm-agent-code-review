APP_ENV=dev
LOG_LEVEL=INFO
OPENAPI_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=code_review

JWT_SECRET=please-change-me-to-32-bytes-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800

DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CHUNK_THRESHOLD=6000
ALLOW_PRIVATE_AI_BASE_URL=false
ENFORCE_AI_BASE_URL_DNS_CHECK=false

AGENT_GOVERNANCE_SCHEDULER_ENABLED=true
AGENT_KNOWLEDGE_FETCH_TIMEOUT=15
AGENT_KNOWLEDGE_FETCH_MAX_BYTES=1048576
AGENT_KNOWLEDGE_ALLOW_PRIVATE_URLS=false
AGENT_KNOWLEDGE_ENFORCE_DNS_CHECK=false
AGENT_KNOWLEDGE_GITHUB_TOKEN=

MAX_UPLOAD_SIZE=20971520
ALLOWED_EXTENSIONS=["*"]

CORS_ORIGINS=["http://localhost:5173"]

MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=code_review
MYSQL_USER=code_review
MYSQL_PASSWORD=code_review123
