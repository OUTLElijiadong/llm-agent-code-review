APP_ENV=dev
LOG_LEVEL=INFO
OPENAPI_ENABLED=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=code_review

JWT_SECRET=please-change-me-to-32-bytes-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=604800

# 内测阶段开启后，注册必须同时提交数学验证码和一次性内测码。
BETA_REGISTRATION_ENABLED=false
# 开启内测注册前设置至少 32 字符的独立随机值，不得与 JWT_SECRET 相同。
BETA_CODE_PEPPER=please-change-me-to-independent-32-byte-random-string

DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_CHUNK_THRESHOLD=6000
DEEPSEEK_CONTEXT_WINDOW_TOKENS=1000000
DEEPSEEK_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_COMPACTION_THRESHOLD_TOKENS=850000
DEEPSEEK_COMPACTION_KEEP_RECENT_TOKENS=200000
ALLOW_PRIVATE_AI_BASE_URL=false
ENFORCE_AI_BASE_URL_DNS_CHECK=false

AGENT_GOVERNANCE_SCHEDULER_ENABLED=true
# 周期 Skill/事件触发默认关闭，避免后台隐式调用模型；确认预算后再显式开启。
SKILL_SCHEDULER_ENABLED=false
SKILL_EVENT_TRIGGER_ENABLED=false
AGENT_KNOWLEDGE_FETCH_TIMEOUT=15
AGENT_KNOWLEDGE_FETCH_MAX_BYTES=1048576
AGENT_KNOWLEDGE_ALLOW_PRIVATE_URLS=false
AGENT_KNOWLEDGE_ENFORCE_DNS_CHECK=false
AGENT_KNOWLEDGE_GITHUB_TOKEN=

# 宿主机运维白名单执行器仅监听 Unix Socket；生产令牌至少 32 字符。
OPS_AUTOMATION_ENABLED=true
OPS_EXECUTOR_SOCKET=/run/prism-ops/agent.sock
OPS_EXECUTOR_TOKEN=change_me_to_an_independent_64_character_random_token

MAX_UPLOAD_SIZE=20971520
ALLOWED_EXTENSIONS=["*"]

CORS_ORIGINS=["http://localhost:5173"]

MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=code_review
MYSQL_USER=code_review
MYSQL_PASSWORD=code_review123
