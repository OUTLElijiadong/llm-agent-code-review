ARG RUNTIME_BASE=nginx:1.27-alpine
FROM ${RUNTIME_BASE}

# The frontend is built and type-checked before deployment. Keeping this
# runtime image free of Node avoids exhausting a small production host during
# an otherwise static-site release. The reviewed Nginx files are copied too,
# so health/readiness routing cannot silently remain on the base image version.
COPY dist/ /usr/share/nginx/html/
COPY dist/ /opt/prism-dist/
COPY nginx.conf /etc/nginx/nginx.conf
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --chmod=0755 docker-entrypoint.d/30-retain-versioned-assets.sh /docker-entrypoint.d/30-retain-versioned-assets.sh

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
