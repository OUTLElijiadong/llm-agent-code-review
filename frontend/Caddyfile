{
    email admin@lijiadong.cn
    servers {
        protocols h1 h2
    }
}

(app_gateway) {
    encode gzip zstd

    request_body {
        max_size 50MB
    }

    handle /api/ws/* {
        reverse_proxy backend:8000
    }

    handle /api/agents/events* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /healthz {
        reverse_proxy backend:8000
    }

    handle /docs {
        reverse_proxy backend:8000
    }

    handle /redoc {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle {
        root * /usr/share/caddy
        try_files {path} {path}/ /index.html
        file_server
    }
}

# 域名 HTTP：只允许跳转到 HTTPS，不直接提供应用或 API
http://lijiadong.cn {
    redir https://lijiadong.cn{uri} permanent
}

http://www.lijiadong.cn {
    redir https://lijiadong.cn{uri} permanent
}

http:// {
    redir https://lijiadong.cn{uri} permanent
}

# 域名 HTTPS：自动证书 + HSTS
lijiadong.cn {
    tls {
        key_type rsa2048
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    import app_gateway
}
