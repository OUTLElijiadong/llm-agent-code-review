{
    email admin@lijiadong.cn
    servers {
        protocols h1 h2
    }
}

(app_gateway) {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000"
    }

    request_body {
        max_size 50MB
    }

    handle /api/ws/* {
        reverse_proxy backend:8000
    }

    handle /api/agents/events* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /healthz {
        reverse_proxy backend:8000
    }

    handle /docs {
        reverse_proxy backend:8000
    }

    handle /redoc {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle {
        root * /usr/share/caddy
        try_files {path} {path}/ /index.html
        file_server
    }
}

http://lijiadong.cn {
    redir https://lijiadong.cn{uri} permanent
}

http:// {
    redir https://lijiadong.cn{uri} permanent
}

lijiadong.cn {
    tls {
        key_type rsa2048
    }
    import app_gateway
}
